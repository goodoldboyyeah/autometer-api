      <if test="deployunitid != null  and deployunitid != ''"> deployunitid =#{deployunitid}</if>
      <if test="modelname != null  and modelname != ''">and modelname =#{modelname}</if>
      <if test="servicetype != null  and servicetype != ''">and servicetype =#{servicetype}</if>
      <if test="projectid != null  and projectid != ''">and projectid =#{projectid}</if>
    </where>
    order by lastmodify_time  DESC
  </select>

  <update id="updateDeploy" parameterType="com.zoctan.api.entity.DeployunitModel">
    update deployunit_model set modelname = #{modelname},dgroup = #{dgroup},version = #{version}, memo = #{memo}, creator = #{creator},
